# --- Database ---
DATABASE_URL=postgresql+psycopg://cardpulse:cardpulse@localhost:5432/cardpulse

# --- Pokemon TCG API (catalog). Optional key; it only raises the rate limit. ---
POKEMON_TCG_API_KEY=

# --- Price ingestion ---
# Which adapter to use. Available adapters: pokemontcg
PRICE_SOURCE_NAME=pokemontcg
# Override the adapter's default base URL. Blank = adapter default (https://api.pokemontcg.io/v2)
PRICE_API_BASE_URL=
# API key for the price source. Blank = the pokemontcg adapter falls back to POKEMON_TCG_API_KEY
PRICE_API_KEY=
# HTTP timeout per request, in seconds
PRICE_REQUEST_TIMEOUT_SECONDS=30
# Pages fetched per run when --max-pages is not given (0 = all pages; one page = up to 250 cards)
PRICE_MAX_PAGES=1

LOG_LEVEL=INFO
