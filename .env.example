# --- Database ---
DATABASE_URL=postgresql+psycopg://cardpulse:cardpulse@localhost:5432/cardpulse

# --- Pokemon TCG API (catalog). Optional key; it only raises the rate limit. ---
POKEMON_TCG_API_KEY=

# --- Price ingestion ---
# Which adapter to use. Available adapters: pokemontcg
PRICE_SOURCE_NAME=pokemontcg
# Override the adapter's default base URL. Blank = adapter default (https://api.pokemontcg.io/v2)
PRICE_API_BASE_URL=
# API key for the price source. Blank = the pokemontcg adapter falls back to POKEMON_TCG_API_KEY
PRICE_API_KEY=
# HTTP timeout per request, in seconds
PRICE_REQUEST_TIMEOUT_SECONDS=30
# Pages fetched per run when --max-pages is not given (0 = all pages; one page = up to 250 cards)
PRICE_MAX_PAGES=1

LOG_LEVEL=INFO

# --- Entity resolution ---
# Attribute matches scoring at or above this (0-100) are accepted automatically
MATCH_AUTO_THRESHOLD=90
# Candidates scoring below this are not even suggested in the review queue
MATCH_REVIEW_MIN_SCORE=50

# --- Pricing (market values, buyback policy, anomaly rules) ---
# Only series whose observation_key matches one of these patterns get market values
PRICING_HEADLINE_PATTERNS=tcgplayer/*/market,cardmarket/trendPrice
# Series with no observation for more than this many days are flagged stale
PRICING_STALE_DAYS=7
# Fewer observations than this in 30 days -> insufficient_observations
PRICING_MIN_OBSERVATIONS=3
# Modified z-score above which a price is a statistical outlier
PRICING_OUTLIER_Z=3.5
# Move vs the previous 7-day median (percent) that counts as a spike or drop
PRICING_SPIKE_PCT=50
# Spread between two sources' medians (percent) that counts as a conflict
PRICING_CONFLICT_PCT=25
# Buyback discounts from market value (0-1): HIGH <= MEDIUM <= LOW
PRICING_BUYBACK_DISCOUNT_HIGH=0.15
PRICING_BUYBACK_DISCOUNT_MEDIUM=0.30
PRICING_BUYBACK_DISCOUNT_LOW=0.50
# Flat discount for the acquisition (buy) price and markup for the retail price
PRICING_BUY_DISCOUNT=0.30
PRICING_RETAIL_MARKUP=0.10
# Liquidity cannot be inferred from provider aggregates; treat it as low or medium
PRICING_UNKNOWN_LIQUIDITY=low
